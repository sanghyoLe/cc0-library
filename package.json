{
  "name": "cc0-library-mcp",
  "version": "0.2.12",
  "mcpName": "io.github.sanghyoLe/cc0-library",
  "description": "MCP server and web gallery for CC0-only assets (images, audio, video, HDRIs, textures, 3D models, museum art) from 8 sources, with license evidence per result.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cc0-library-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "catalog",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test test/*.test.mjs",
    "smoke": "tsc && node scripts/smoke.mjs",
    "build:site": "tsc && node scripts/build-site.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cc0",
    "public-domain",
    "mcp",
    "model-context-protocol",
    "assets",
    "openverse",
    "polyhaven",
    "mcp-server",
    "creative-commons",
    "gamedev",
    "game-assets",
    "hdri",
    "textures",
    "3d-models",
    "museum",
    "open-access",
    "wikimedia-commons",
    "internet-archive",
    "sketchfab"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanghyoLe/cc0-library.git"
  },
  "homepage": "https://sanghyole.github.io/cc0-library/",
  "bugs": {
    "url": "https://github.com/sanghyoLe/cc0-library/issues"
  }
}
