{
  "name": "cc0-library-mcp",
  "version": "0.1.0",
  "description": "Search CC0 (public domain dedication) images, audio, HDRIs, textures and 3D models. Ships as an MCP server and a curated source catalog.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cc0-library-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "catalog",
    "LICENSE",
    "catalog/LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test test/*.test.mjs",
    "smoke": "tsc && node scripts/smoke.mjs",
    "build:site": "tsc && node scripts/build-site.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cc0",
    "public-domain",
    "mcp",
    "model-context-protocol",
    "assets",
    "openverse",
    "polyhaven"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanghyoLe/cc0-library.git"
  }
}
